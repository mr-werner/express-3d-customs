{
  "framework": "vite",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/site-content",
      "destination": "https://www.blueprintwebstudio.com/api/site-editor?site=e3d.blueprintwebstudio.com"
    },
    {
      "source": "/((?!api/|assets/|designer/).*)",
      "destination": "/index.html"
    }
  ]
}
