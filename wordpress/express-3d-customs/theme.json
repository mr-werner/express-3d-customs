{
  "$schema": "https://schemas.wp.org/wp/6.7/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": { "contentSize": "760px", "wideSize": "1240px" },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "palette": [
        { "slug": "charcoal", "name": "Charcoal", "color": "#283033" },
        { "slug": "charcoal-deep", "name": "Charcoal deep", "color": "#1d2427" },
        { "slug": "charcoal-soft", "name": "Charcoal soft", "color": "#333d41" },
        { "slug": "red", "name": "Filament red", "color": "#c34b3c" },
        { "slug": "red-deep", "name": "Filament red deep", "color": "#a63c2f" },
        { "slug": "cream", "name": "Cream", "color": "#f2ddb9" },
        { "slug": "cream-light", "name": "Cream light", "color": "#faf3e6" },
        { "slug": "paper", "name": "Paper", "color": "#f6efe2" },
        { "slug": "nozzle", "name": "Nozzle gray", "color": "#8f8a85" },
        { "slug": "text-muted", "name": "Muted text", "color": "#5b6264" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "vh", "vw", "%"],
      "spacingSizes": [
        { "slug": "20", "name": "XS", "size": "10px" },
        { "slug": "30", "name": "S", "size": "18px" },
        { "slug": "40", "name": "M", "size": "clamp(24px, 3vw, 34px)" },
        { "slug": "50", "name": "L", "size": "clamp(34px, 5vw, 56px)" },
        { "slug": "60", "name": "XL", "size": "clamp(56px, 8vw, 110px)" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "heading",
          "name": "Chakra Petch",
          "fontFamily": "\"Chakra Petch\", Figtree, system-ui, sans-serif",
          "fontFace": [
            { "fontFamily": "Chakra Petch", "fontWeight": "500", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/chakra-petch-500.woff2"] },
            { "fontFamily": "Chakra Petch", "fontWeight": "600", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/chakra-petch-600.woff2"] },
            { "fontFamily": "Chakra Petch", "fontWeight": "700", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/chakra-petch-700.woff2"] }
          ]
        },
        {
          "slug": "body",
          "name": "Figtree",
          "fontFamily": "Figtree, system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            { "fontFamily": "Figtree", "fontWeight": "400 800", "fontStyle": "normal", "fontDisplay": "swap", "src": ["file:./assets/fonts/figtree-variable.woff2"] }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "name": "Small", "size": "15px" },
        { "slug": "medium", "name": "Medium", "size": "17px" },
        { "slug": "large", "name": "Large", "size": "19px", "fluid": { "min": "17px", "max": "19px" } },
        { "slug": "x-large", "name": "Extra large", "size": "26px", "fluid": { "min": "22px", "max": "26px" } },
        { "slug": "xx-large", "name": "Section heading", "size": "56px", "fluid": { "min": "32px", "max": "56px" } },
        { "slug": "huge", "name": "Hero", "size": "78px", "fluid": { "min": "40px", "max": "78px" } }
      ]
    }
  },
  "styles": {
    "color": { "background": "var(--wp--preset--color--paper)", "text": "var(--wp--preset--color--charcoal)" },
    "typography": { "fontFamily": "var(--wp--preset--font-family--body)", "fontSize": "var(--wp--preset--font-size--medium)", "lineHeight": "1.6" },
    "spacing": {
      "blockGap": "18px",
      "padding": { "left": "20px", "right": "20px" }
    },
    "elements": {
      "heading": {
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.05", "letterSpacing": "-0.01em" }
      },
      "h1": { "typography": { "fontSize": "var(--wp--preset--font-size--huge)" } },
      "h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
      "h3": { "typography": { "fontSize": "21px", "fontWeight": "600" } },
      "link": {
        "color": { "text": "currentColor" },
        ":hover": { "color": { "text": "var(--wp--preset--color--red)" } }
      },
      "button": {
        "color": { "background": "var(--wp--preset--color--red)", "text": "#ffffff" },
        "border": { "radius": "10px" },
        "typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "fontSize": "16px", "letterSpacing": "0.04em", "textTransform": "uppercase" },
        "spacing": { "padding": { "top": "15px", "bottom": "15px", "left": "26px", "right": "26px" } },
        ":hover": { "color": { "background": "#d65b4b", "text": "#ffffff" } }
      }
    },
    "blocks": {
      "core/navigation": {
        "typography": { "fontSize": "15px", "fontWeight": "600" }
      },
      "core/details": {
        "border": { "bottom": { "color": "rgba(40, 48, 51, .14)", "width": "1px", "style": "solid" } },
        "spacing": { "padding": { "top": "18px", "bottom": "18px" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" }
  ],
  "customTemplates": [
    { "name": "page-full-width", "title": "Full width page (no title)", "postTypes": ["page"] }
  ]
}
